# ============================================================
# Backend Configuration
# ============================================================

# Comma-separated pool of at least 2 API keys (assigned key_1, key_2, ... in order)
LLM_API_KEYS=your_primary_api_key_here,your_secondary_api_key_here

# LiteLLM model identifier applied across keys (e.g. gemini/gemini-2.0-flash, groq/llama-3.1-8b-instant, openai/gpt-4o-mini)
LLM_MODEL=gemini/gemini-2.0-flash

# Optional: comma-separated per-key models matching LLM_API_KEYS order (leave empty to use LLM_MODEL for all keys)
LLM_MODELS=

# SQLite database path inside container volume (/data/app.db)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins allowed to call the backend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to true to enable the X-Simulate-Failure test hook (required on deployed backend)
ENABLE_FAILURE_SIMULATION=true

# LiteLLM response cache configuration (local = in-memory, disk = persistent file cache)
CACHE_ENABLED=true
CACHE_TYPE=local

# Optional default system prompt
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise AI assistant.

# ============================================================
# Frontend Configuration
# ============================================================

# Public backend URL consumed by the React app at build time
VITE_API_BASE_URL=http://localhost:8000
